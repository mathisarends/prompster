  "servers": [
    {
      "name": "session",
      "url": "ws://localhost:8000/api/v1/sessions/{session_id}/stream",
      "x-rpckit-transport": {
        "type": "websocket",
        "messageEncoding": "json",
        "frameType": "text"
      },
      "variables": {
        "session_id": {
          "default": "{session_id}"
        }
      }
    }
  ],
