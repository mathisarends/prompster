{
  "name": "prompster-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "api:generate": "lit-canon-api generate",
    "api:check": "lit-canon-api check",
    "api:export": "cd .. && uv run --package backend python frontend/scripts/export-openapi.py",
    "api:check-backend": "cd .. && uv run --package backend python frontend/scripts/export-openapi.py --check",
    "generate:api": "lit-canon-api generate",
    "download:openapi": "node scripts/download-openapi.mjs",
    "generate:streams": "cd .. && uv run --package backend fastapi-canon generate --config codegen.toml",
    "check:streams": "cd .. && uv run --package backend fastapi-canon generate --config codegen.toml --check",
    "lint": "pnpm run typecheck && pnpm run format:check",
    "format": "node scripts/curly.mjs --write && prettier --write .",
    "format:check": "node scripts/curly.mjs --check && prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "review:capture": "tsx scripts/capture-review.ts",
    "review:choreography": "tsx scripts/capture-choreography.ts",
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@lit/localize": "^0.12.2",
    "@tanstack/lit-query": "0.2.25",
    "@tanstack/query-core": "5.104.0",
    "dompurify": "^3.4.14",
    "lit": "^3.3.3",
    "lit-canon-fetch": "github:mathisarends/lit-canon#02e362ad9684005270f907b97ec4260bf2d9b924&path:packages/fetch",
    "lucide": "1.48.0",
    "marked": "^18.0.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.58.2",
    "@types/qrcode": "^1.5.6",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "lit-canon-api": "github:mathisarends/lit-canon#02e362ad9684005270f907b97ec4260bf2d9b924&path:packages/api",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
