{
  "name": "prompster-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "api:generate": "node scripts/prepare-api.mjs && orval --config orval.config.mjs && node scripts/verify-api.mjs",
    "api:check": "node scripts/check-api.mjs",
    "api:export": "cd .. && uv run --package backend python frontend/scripts/export-openapi.py",
    "api:check-backend": "cd .. && uv run --package backend python frontend/scripts/export-openapi.py --check",
    "generate:api": "npm run api:generate",
    "download:openapi": "node scripts/download-openapi.mjs",
    "generate:rpc": "cd .. && uv run --package backend rpckit generate --config rpcgen.toml",
    "check:rpc": "cd .. && uv run --package backend rpckit generate --config rpcgen.toml --check",
    "lint": "npm run typecheck && npm run format:check",
    "format": "node scripts/curly.mjs --write && prettier --write .",
    "format:check": "node scripts/curly.mjs --check && prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "review:capture": "tsx scripts/capture-review.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/lit-query": "0.2.25",
    "@tanstack/query-core": "5.104.0",
    "dompurify": "^3.4.14",
    "lit": "^3.3.3",
    "lucide": "1.48.0",
    "marked": "^18.0.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/qrcode": "^1.5.6",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "orval": "8.38.0",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
}
