ENV=dev
LOG_LEVEL=

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=your_spotify_redirect_uri_here
SPOTIFY_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

OPENAI_API_KEY=your_openai_api_key_here

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_CHECKOUT_PRODUCT_NAME=Prompster
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

POSTGRES_USER=prompster
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=prompster

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=supersecret

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=your_google_redirect_uri_here

RESEND_API_KEY=your_resend_env_key_here
