ENV=dev
LOG_LEVEL=

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=your_spotify_redirect_uri_here
SPOTIFY_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# OpenAI provider: API key authentication
OPENAI_API_KEY=your_openai_api_key_here

# Codex provider: run codex login, then bash scripts/start_codex.sh.
# Optional absolute login directory (e.g. C:/Users/you/.codex).
# The script falls back to CODEX_HOME or ~/.codex when empty.
# Direct use of compose.codex.yml requires this value to be set.
CODEX_AUTH_DIR=

POSTGRES_USER=prompster
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=prompster

S3_ACCESS_KEY=prompster
S3_SECRET_KEY=supersecret

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=your_google_redirect_uri_here
